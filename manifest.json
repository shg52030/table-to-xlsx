{
  "manifest_version": 3,
  "name": "网页表格导出 Excel",
  "version": "1.0.0",
  "description": "把网页里的表格导出为 xlsx：支持合并单元格还原、多表多 Sheet、隐藏行过滤、数字自动识别。纯本地处理，不联网。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页表格导出 Excel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/parser.js", "content/xlsx.js", "content/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
